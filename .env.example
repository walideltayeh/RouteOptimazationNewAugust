# Copy to .env and fill in. Never commit the real .env (it is gitignored).

# --- Admin login (required for the Admin / Super User login) ---
SUPERUSER_EMAIL=admin@example.com
SUPERUSER_PASSWORD=choose-a-strong-password

# --- Maps (required for the Territory Map / Rep Map pages) ---
# Get a free token at https://account.mapbox.com/access-tokens/
VITE_MAPBOX_TOKEN=pk.your-mapbox-public-token

# --- Optional: true road distances for the "Road-aware" distance model ---
# URL of a self-hosted OSRM instance with the relevant map extract.
# When unset, road-aware mode uses the built-in detour + barrier estimate.
# OSRM_URL=http://localhost:5001
